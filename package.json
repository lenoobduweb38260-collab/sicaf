{
  "name": "gmao-sicaf",
  "productName": "GMAO SICAF",
  "version": "1.0.0",
  "description": "GMAO (Gestion de Maintenance Assistée par Ordinateur) complète et personnalisable pour Windows 10/11 : multi-site, comptes internes, profils hiérarchiques, plans 3D, inventaire par code-barres, RH, achats et factures.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js --open",
    "serve": "node server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e/run.js",
    "electron": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "manifeste": "node scripts/manifeste-maj.js dist"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.sicaf.gmao",
    "productName": "GMAO SICAF",
    "copyright": "SICAF",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/**/*",
      "package.json",
      "!**/*.test.js",
      "!**/*.md"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "GMAO-SICAF-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GMAO SICAF",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "GMAO-SICAF-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GMAO-SICAF-Portable-${version}.${ext}"
    },
    "publish": null,
    "afterPack": "scripts/fusibles.js"
  },
  "author": "SICAF",
  "homepage": "https://github.com/lenoobduweb38260-collab/sicaf",
  "gmao": {
    "depotMisesAJour": "lenoobduweb38260-collab/sicaf"
  }
}
